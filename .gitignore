# Local agent workspace — not project content
.workbuddy-ai/

# Generated gap-analysis artifacts — regenerate with scripts/doc-graph.py
# The report itself (analysis/GAP-ANALYSIS.md) is versioned as a design record.
analysis/graph.json
analysis/engine-graph.mmd

# Python bytecode — appears whenever scripts/doc-graph.py is imported rather
# than run directly (e.g. by a verification helper). Never project content.
__pycache__/
*.pyc

# macOS
.DS_Store


# Rust workspace build artifacts (forhemit/)
forhemit/target/

# Tauri ACL — autogenerated permission files, regenerated by tauri-build from
# the command inventory in forhemit/app/src-tauri/build.rs on every build.
forhemit/app/src-tauri/permissions/


# Frontend dependencies and build output (app/)
forhemit/app/node_modules/
forhemit/app/dist/

# Generated at release time by src-tauri/scripts/gen-azure-signing-config.mjs
# (Azure Artifact Signing overlay) — never project content.
forhemit/app/src-tauri/tauri.azure-signing.conf.json
