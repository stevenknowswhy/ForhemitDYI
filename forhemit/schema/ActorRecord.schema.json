{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActorRecord",
  "description": "The `actor` field of the audit event contract (Audit doc §63): who or\nwhat acted, identified and classified.",
  "type": "object",
  "properties": {
    "actor_id": {
      "description": "Stable identifier for the actor (user id, service account name, …).",
      "allOf": [
        {
          "$ref": "#/definitions/ActorId"
        }
      ]
    },
    "classification": {
      "description": "Top-level human/service/automation/external classification.",
      "allOf": [
        {
          "$ref": "#/definitions/ActorClassification"
        }
      ]
    },
    "kind": {
      "description": "Finer-grained actor kind (Audit doc §7), when known.",
      "anyOf": [
        {
          "$ref": "#/definitions/ActorKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "origination": {
      "description": "How the action originated (Audit doc §8), when known.",
      "anyOf": [
        {
          "$ref": "#/definitions/ActionOrigination"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "actor_id",
    "classification"
  ],
  "definitions": {
    "ActionOrigination": {
      "description": "How an action originated — the human-vs-system distinction Audit doc §8\nrequires so automation never \"appear[s] as though a human personally\nperformed\" it.",
      "oneOf": [
        {
          "description": "Initiated by a human.",
          "type": "string",
          "const": "human_initiated"
        },
        {
          "description": "Approved by a human.",
          "type": "string",
          "const": "human_approved"
        },
        {
          "description": "Generated by the system.",
          "type": "string",
          "const": "system_generated"
        },
        {
          "description": "Produced by an automated workflow.",
          "type": "string",
          "const": "automated_workflow"
        },
        {
          "description": "Produced by an external integration.",
          "type": "string",
          "const": "external_integration"
        },
        {
          "description": "AI-assisted work.",
          "type": "string",
          "const": "ai_assisted"
        },
        {
          "description": "AI-generated content.",
          "type": "string",
          "const": "ai_generated"
        }
      ]
    },
    "ActorClassification": {
      "description": "Top-level classification of an audit actor — the spec sample's\n`Human | Service | Automation | External` grouping.\n\nIntegrity rule 5 requires \"human, automated, AI, integration, and\nsystem actions\" to be distinguishable: the top-level classification\ngroups them, and the finer-grained [`ActorKind`] (§7) plus\n[`ActionOrigination`] (§8) on [`ActorRecord`] preserve the\ndistinctions.",
      "oneOf": [
        {
          "description": "A person.",
          "type": "string",
          "const": "human"
        },
        {
          "description": "A service account or system process acting on its own behalf.",
          "type": "string",
          "const": "service"
        },
        {
          "description": "An automated workflow or AI agent.",
          "type": "string",
          "const": "automation"
        },
        {
          "description": "An actor outside the platform — an external integration or party.",
          "type": "string",
          "const": "external"
        }
      ]
    },
    "ActorId": {
      "description": "Identifies the actor behind an event — Audit doc §7: the platform\nnever records a bare \"User changed value\" without saying who or\nwhat did it.",
      "type": "string"
    },
    "ActorKind": {
      "description": "Who or what performed an action. Variants are the Audit doc §7 list,\nverbatim.",
      "oneOf": [
        {
          "description": "The business owner.",
          "type": "string",
          "const": "owner"
        },
        {
          "description": "A co-owner of the business.",
          "type": "string",
          "const": "co_owner"
        },
        {
          "description": "An engaged professional (CPA, attorney, valuation, …).",
          "type": "string",
          "const": "professional"
        },
        {
          "description": "An employee of the business.",
          "type": "string",
          "const": "employee"
        },
        {
          "description": "A lender.",
          "type": "string",
          "const": "lender"
        },
        {
          "description": "A trustee.",
          "type": "string",
          "const": "trustee"
        },
        {
          "description": "An external buyer.",
          "type": "string",
          "const": "buyer"
        },
        {
          "description": "A platform administrator.",
          "type": "string",
          "const": "platform_administrator"
        },
        {
          "description": "A service account.",
          "type": "string",
          "const": "service_account"
        },
        {
          "description": "An automated workflow.",
          "type": "string",
          "const": "automation"
        },
        {
          "description": "An AI agent.",
          "type": "string",
          "const": "ai_agent"
        },
        {
          "description": "An external integration.",
          "type": "string",
          "const": "integration"
        },
        {
          "description": "A system process.",
          "type": "string",
          "const": "system_process"
        }
      ]
    }
  }
}
