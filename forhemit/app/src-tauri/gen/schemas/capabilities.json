{"main-capability":{"identifier":"main-capability","description":"Least-privilege grants for the main window: every application command the frontend invokes through the IPC bridge, and nothing else. No core permissions (the frontend uses only `invoke`) and no plugin permissions (the updater is driven Rust-side). Application commands are ACL-gated because build.rs registers them via AppManifest::commands; any command added to `invoke_handler` must also be granted here or the webview invocation is refused.","local":true,"windows":["main"],"permissions":["allow-destination-get","allow-destination-create","allow-destination-edit","allow-destination-confirm","allow-destination-mark-working","allow-destination-archive","allow-destination-completeness","allow-journey-state","allow-journey-start","allow-journey-record","allow-journey-revise","allow-journey-skip","allow-snapshot-current","allow-snapshot-record","allow-snapshot-revise","allow-audit-recent","allow-audit-verify","allow-scenario-create","allow-scenario-families","allow-scenario-family-view","allow-scenario-version-view","allow-scenario-add-assumption","allow-scenario-add-unknown","allow-scenario-resolve-unknown","allow-scenario-add-constraint","allow-scenario-add-nonnegotiable","allow-scenario-record-conflict","allow-scenario-resolve-conflict","allow-scenario-finalize","allow-scenario-set-readiness","allow-scenario-what-if","allow-scenario-comparison","allow-vault-status","allow-vault-setup","allow-vault-recover","allow-vault-import","allow-vault-documents","allow-vault-document-history","allow-vault-document-content","allow-vault-search","allow-vault-backup","allow-package-preview","allow-package-export","allow-update-check","allow-update-install"]}}