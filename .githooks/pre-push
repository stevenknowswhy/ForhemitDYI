#!/usr/bin/env bash
#
# pre-push guard — refuses to push `main` while content is left uncommitted.
#
# This repo is a design bible: one Markdown document per engine, committed one
# file at a time. Work sessions routinely end with freshly written docs that
# were never staged, so a bare `git push` would silently ship a stale tree.
#
# This hook turns "did I remember to commit everything?" from a habit you have
# to recall into a property of the system.
#
# Deliberate bypass:  git push --no-verify
#
set -uo pipefail

PROTECTED_REF="refs/heads/main"
ZERO="0000000000000000000000000000000000000000"

cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0

# --- 1. Is this push targeting the protected branch? -------------------------
# stdin lines are: <local ref> <local oid> <remote ref> <remote oid>
targets_main=0
while read -r _local_ref local_oid remote_ref _remote_oid; do
  [ -n "${remote_ref:-}" ] || continue
  [ "$remote_ref" = "$PROTECTED_REF" ] || continue
  [ "${local_oid:-}" != "$ZERO" ] || continue   # branch deletion, not a content push
  targets_main=1
done

[ "$targets_main" -eq 1 ] || exit 0

# --- 2. Is the working tree clean? -------------------------------------------
# --porcelain covers untracked, modified, staged and deleted in one shot.
# Ignored paths (.workbuddy-ai/, .DS_Store) are excluded by git itself.
dirty="$(git status --porcelain --untracked-files=all)"
[ -n "$dirty" ] || exit 0

# --- 3. Refuse, and say precisely what to do about it -------------------------
count="$(printf '%s\n' "$dirty" | grep -c .)"

printf '\n'
printf '  PUSH BLOCKED — %s uncommitted file(s) in the working tree\n' "$count"
printf '  Pushing now would send a stale tree to GitHub.\n'
printf '\n'
git status --short --untracked-files=all | sed 's/^/      /'
printf '\n'
printf '  Commit them one document at a time (repo convention):\n'
printf '\n'
printf '      git add "<file>" && git commit -m "Add <Title>"\n'
printf '\n'
printf '  Or let the sweep commit the whole backlog for you:\n'
printf '\n'
printf '      ./scripts/sync-docs.sh\n'
printf '\n'
printf '  To push anyway, bypass this guard deliberately:\n'
printf '\n'
printf '      git push --no-verify\n'
printf '\n'

exit 1
