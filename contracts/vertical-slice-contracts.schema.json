{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forhemit:schema:california-esop-exploration:1.1.0",
  "title": "California ESOP Exploration Vertical Slice Contracts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "desired_outcome",
    "business_current_state",
    "scenario_version",
    "scenario_readiness",
    "professional_review_package",
    "professional_determination",
    "disclosure_record",
    "event_envelope",
    "jev_evaluation_reference",
    "consent_records",
    "external_ai_disclosure_record"
  ],
  "properties": {
    "desired_outcome": {
      "$ref": "#/$defs/DesiredOutcome"
    },
    "business_current_state": {
      "$ref": "#/$defs/BusinessCurrentState"
    },
    "scenario_version": {
      "$ref": "#/$defs/ScenarioVersion"
    },
    "scenario_readiness": {
      "$ref": "#/$defs/ScenarioReadiness"
    },
    "professional_review_package": {
      "$ref": "#/$defs/ProfessionalReviewPackage"
    },
    "professional_determination": {
      "$ref": "#/$defs/ProfessionalDetermination"
    },
    "disclosure_record": {
      "$ref": "#/$defs/DisclosureRecord"
    },
    "event_envelope": {
      "$ref": "#/$defs/EventEnvelope"
    },
    "jev_evaluation_reference": {
      "$ref": "#/$defs/JevEvaluationReference"
    },
    "consent_records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/ConsentRecord"
      }
    },
    "external_ai_disclosure_record": {
      "$ref": "#/$defs/ExternalAIDisclosureRecord"
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,127}$"
    },
    "Semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "SourceAuthority": {
      "enum": [
        "owner_stated",
        "source_supported",
        "professional_attributed",
        "platform_derived",
        "system_recorded"
      ]
    },
    "VersionedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "object_id",
        "version"
      ],
      "properties": {
        "object_type": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ProvenanceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "source_version",
        "information_status",
        "observed_at"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_type": {
          "enum": [
            "owner_input",
            "document",
            "integration",
            "professional",
            "calculation"
          ]
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "information_status": {
          "enum": [
            "stated",
            "supported",
            "verified",
            "conflicted"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "excerpt_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Nonnegotiable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonnegotiable_id",
        "statement",
        "status",
        "source_authority",
        "owner_confirmed_at"
      ],
      "properties": {
        "nonnegotiable_id": {
          "$ref": "#/$defs/Identifier"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "relaxed_by_owner",
            "superseded"
          ]
        },
        "source_authority": {
          "const": "owner_stated"
        },
        "owner_confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "supersedes_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DesiredOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "destination_id",
        "version",
        "owner_id",
        "business_id",
        "transition_horizon",
        "employee_ownership_intent",
        "owner_involvement",
        "objectives",
        "nonnegotiables",
        "source_authority",
        "sensitivity",
        "confirmed_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "destination_id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "owner_id": {
          "$ref": "#/$defs/Identifier"
        },
        "business_id": {
          "$ref": "#/$defs/Identifier"
        },
        "transition_horizon": {
          "enum": [
            "within_1_year",
            "1_to_3_years",
            "3_to_5_years",
            "flexible",
            "unknown"
          ]
        },
        "employee_ownership_intent": {
          "enum": [
            "essential",
            "very_important",
            "explore",
            "unknown"
          ]
        },
        "owner_involvement": {
          "enum": [
            "exit",
            "transition_period",
            "ongoing",
            "unknown"
          ]
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objective_id",
              "statement",
              "priority"
            ],
            "properties": {
              "objective_id": {
                "$ref": "#/$defs/Identifier"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "uniqueItems": true
        },
        "nonnegotiables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Nonnegotiable"
          },
          "uniqueItems": true
        },
        "preferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_authority": {
          "const": "owner_stated"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "field",
        "value",
        "value_status",
        "source_authority",
        "sensitivity",
        "provenance"
      ],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "value_status": {
          "enum": [
            "known",
            "range",
            "unknown",
            "conflicted",
            "stale"
          ]
        },
        "source_authority": {
          "$ref": "#/$defs/SourceAuthority"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "effective_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ProvenanceReference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_status": {
                "const": "unknown"
              }
            },
            "required": [
              "value_status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "BusinessCurrentState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "current_state_id",
        "version",
        "business_id",
        "primary_jurisdiction",
        "facts",
        "source_authority",
        "sensitivity",
        "confirmed_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "current_state_id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "business_id": {
          "$ref": "#/$defs/Identifier"
        },
        "primary_jurisdiction": {
          "const": "US-CA"
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "uniqueItems": true
        },
        "source_authority": {
          "enum": [
            "owner_stated",
            "source_supported"
          ]
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ScenarioVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scenario_id",
        "version",
        "scenario_type",
        "destination_reference",
        "current_state_reference",
        "assumptions",
        "unknowns",
        "conflicts",
        "professional_questions",
        "exploratory_only",
        "source_authority",
        "sensitivity",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "scenario_id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "scenario_type": {
          "const": "esop_exploration"
        },
        "destination_reference": {
          "$ref": "#/$defs/VersionedReference"
        },
        "current_state_reference": {
          "$ref": "#/$defs/VersionedReference"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "professional_questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exploratory_only": {
          "const": true
        },
        "source_authority": {
          "const": "platform_derived"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ScenarioReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_reference",
        "state",
        "deterministic_gates_passed",
        "professionally_validated",
        "source_authority",
        "evaluated_at"
      ],
      "properties": {
        "scenario_reference": {
          "$ref": "#/$defs/VersionedReference"
        },
        "state": {
          "enum": [
            "preliminary",
            "information_needed",
            "modelable",
            "ready_for_comparison",
            "ready_for_professional_review",
            "under_professional_review",
            "revised",
            "superseded",
            "archived"
          ]
        },
        "deterministic_gates_passed": {
          "type": "boolean"
        },
        "professionally_validated": {
          "type": "boolean"
        },
        "source_authority": {
          "const": "platform_derived"
        },
        "jev_evaluation_reference": {
          "oneOf": [
            {
              "$ref": "#/$defs/JevEvaluationReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ProfessionalReviewPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "package_id",
        "version",
        "owner_id",
        "business_id",
        "recipient_id",
        "professional_role",
        "purpose",
        "destination_reference",
        "current_state_reference",
        "scenario_reference",
        "included_categories",
        "excluded_categories",
        "consent_reference",
        "sharing_status",
        "source_authority",
        "sensitivity",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "package_id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "owner_id": {
          "$ref": "#/$defs/Identifier"
        },
        "business_id": {
          "$ref": "#/$defs/Identifier"
        },
        "recipient_id": {
          "$ref": "#/$defs/Identifier"
        },
        "professional_role": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "const": "california_esop_exploration_review"
        },
        "destination_reference": {
          "$ref": "#/$defs/VersionedReference"
        },
        "current_state_reference": {
          "$ref": "#/$defs/VersionedReference"
        },
        "scenario_reference": {
          "$ref": "#/$defs/VersionedReference"
        },
        "included_categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "excluded_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "consent_reference": {
          "allOf": [
            {
              "$ref": "#/$defs/VersionedReference"
            },
            {
              "type": "object",
              "properties": {
                "object_type": {
                  "const": "ConsentRecord"
                }
              }
            }
          ]
        },
        "sharing_status": {
          "enum": [
            "draft",
            "authorized",
            "shared",
            "revoked",
            "expired",
            "superseded"
          ]
        },
        "source_authority": {
          "const": "system_recorded"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ProfessionalDetermination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "determination_id",
        "review_id",
        "professional_id",
        "professional_role",
        "scenario_reference",
        "determination_text",
        "category",
        "source_authority",
        "sensitivity",
        "submitted_at",
        "professional_identity_reference",
        "credential_status"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "determination_id": {
          "$ref": "#/$defs/Identifier"
        },
        "review_id": {
          "$ref": "#/$defs/Identifier"
        },
        "professional_id": {
          "$ref": "#/$defs/Identifier"
        },
        "professional_role": {
          "type": "string",
          "minLength": 1
        },
        "scenario_reference": {
          "$ref": "#/$defs/VersionedReference"
        },
        "determination_text": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "supporting_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionedReference"
          }
        },
        "owner_acknowledged_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_authority": {
          "const": "professional_attributed"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "professional_identity_reference": {
          "$ref": "#/$defs/Identifier"
        },
        "credential_status": {
          "enum": [
            "unverified",
            "self_attested",
            "platform_verified"
          ]
        },
        "credential_verification_reference": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ConsentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "consent_id",
        "owner_id",
        "recipient_id",
        "purpose",
        "resource_references",
        "permissions",
        "status",
        "granted_at",
        "expires_at",
        "source_authority",
        "version",
        "recipient_type",
        "sensitivity"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "consent_id": {
          "$ref": "#/$defs/Identifier"
        },
        "owner_id": {
          "$ref": "#/$defs/Identifier"
        },
        "recipient_id": {
          "$ref": "#/$defs/Identifier"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "resource_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/VersionedReference"
          }
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "existence",
              "summary",
              "detailed",
              "full_view",
              "download"
            ]
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "active",
            "revoked",
            "expired",
            "superseded"
          ]
        },
        "granted_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_authority": {
          "const": "owner_stated"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "recipient_type": {
          "enum": [
            "professional",
            "external_ai"
          ]
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        }
      }
    },
    "DisclosureRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "disclosure_id",
        "consent_reference",
        "package_reference",
        "recipient_id",
        "purpose",
        "disclosed_categories",
        "source_authority",
        "disclosed_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "disclosure_id": {
          "$ref": "#/$defs/Identifier"
        },
        "consent_reference": {
          "allOf": [
            {
              "$ref": "#/$defs/VersionedReference"
            },
            {
              "type": "object",
              "properties": {
                "object_type": {
                  "const": "ConsentRecord"
                }
              }
            }
          ]
        },
        "package_reference": {
          "$ref": "#/$defs/VersionedReference"
        },
        "recipient_id": {
          "$ref": "#/$defs/Identifier"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "disclosed_categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_authority": {
          "const": "system_recorded"
        },
        "disclosed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "occurred_at",
        "actor_type",
        "actor_reference",
        "source_module",
        "subject_reference",
        "correlation_id",
        "causation_id",
        "idempotency_key",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "event_id": {
          "$ref": "#/$defs/Identifier"
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor_type": {
          "enum": [
            "human",
            "jev",
            "system",
            "integration",
            "professional"
          ]
        },
        "actor_reference": {
          "$ref": "#/$defs/Identifier"
        },
        "source_module": {
          "type": "string",
          "minLength": 1
        },
        "subject_reference": {
          "$ref": "#/$defs/VersionedReference"
        },
        "correlation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "causation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/Identifier"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "JevEvaluationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_id",
        "question_id",
        "question_version",
        "threshold_policy_id",
        "threshold_policy_version",
        "state_hash",
        "authority_effect",
        "consent_reference",
        "request_hash",
        "criteria_hash",
        "minimization_policy_id",
        "minimization_policy_version",
        "external_ai_disclosure_reference"
      ],
      "properties": {
        "evaluation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "question_id": {
          "type": "string",
