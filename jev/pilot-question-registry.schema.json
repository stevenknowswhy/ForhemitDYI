{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forhemit:schema:jev-question-registry:1.0.0",
  "title": "JevQuestionRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "model_alias",
    "status",
    "threshold_policy_registry",
    "questions"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "model_alias": {
      "const": "jev-latest"
    },
    "status": {
      "enum": [
        "evaluation_only",
        "shadow",
        "production"
      ]
    },
    "threshold_policy_registry": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "state",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "example",
            "counterexample"
          ]
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "owner_engine",
        "type",
        "instructions",
        "maximum_authority",
        "fallback",
        "consent_purpose",
        "threshold_policy",
        "examples",
        "input_contract"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "owner_engine": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "noul",
            "choice",
            "score"
          ]
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "oneOf": [
            {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "criteria_source": {
          "type": "string",
          "minLength": 1
        },
        "required_fallback_option": {
          "type": "string",
          "minLength": 1
        },
        "maximum_authority": {
          "enum": [
            "signal_only",
            "human_confirmed",
            "reversible_route",
            "professional_only",
            "no_role"
          ]
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "consent_purpose": {
          "type": "string",
          "minLength": 1
        },
        "threshold_policy": {
          "type": "string",
          "minLength": 1
        },
        "examples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "input_contract": {
          "$ref": "#/$defs/input_contract"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "noul"
            }
          },
          "required": [
            "criteria"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "choice"
            }
          },
          "anyOf": [
            {
              "required": [
                "criteria"
              ]
            },
            {
              "required": [
                "criteria_source"
              ]
            }
          ]
        },
        {
          "properties": {
            "type": {
              "const": "score"
            }
          },
          "required": [
            "criteria"
          ]
        }
      ]
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "allowed_fields",
        "forbidden_fields",
        "raw_documents_allowed",
        "minimization_policy_id",
        "minimization_policy_version"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "allowed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "raw_documents_allowed": {
          "const": false
        },
        "minimization_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "minimization_policy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}
